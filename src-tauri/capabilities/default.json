{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WackCode desktop permissions",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
  ]
}
