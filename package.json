{
  "name": "wackcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:worker": "pnpm --dir worker build",
    "prepare:worker": "node scripts/prepare-worker.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "mock:provider": "node scripts/mock-provider.mjs",
    "mock:mcp": "node scripts/mock-mcp-server.mjs --http 43128",
    "dev:desktop": "tauri dev --runner \"$PWD/scripts/dev-runner.sh\"",
    "dev:background": "node scripts/dev-background.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build:desktop": "pnpm prepare:runtime && tauri build",
    "build:desktop:debug": "pnpm prepare:runtime && tauri build --debug",
    "test:web": "vitest run",
    "test:worker": "pnpm --dir worker test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm test:web && pnpm test:worker && pnpm test:rust",
    "check": "pnpm build:web && pnpm build:worker && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lowlight": "^3.3.0",
    "motion": "^13.4.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.5.0"
}
