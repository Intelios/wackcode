{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WackCode",
  "version": "1.3.2",
  "identifier": "com.wackcode.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:worker && vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web && pnpm prepare:worker",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "WackCode",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 17, "y": 26 },
        "dragDropEnabled": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/backgrounds/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/wackcode-node"],
    "resources": ["resources/worker", "resources/npm"],
    "copyright": "Copyright © 2026 Jack",
    "category": "DeveloperTool",
    "shortDescription": "A local desktop UI for Pi",
    "longDescription": "WackCode is a local desktop coding workspace powered by the Pi coding agent.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
